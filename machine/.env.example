# ==============================================================================
# Pix Server 环境变量模板
# 用户侧上机配置：复制为 .env 并填入实际值
# ==============================================================================

# 代理鉴权共享密钥（与 Worker 的 PIX_SERVER_SECRET 保持一致，切勿泄露）
PIX_SERVER_SECRET=your_pix_server_secret_here

# 容器内监听端口与地址（默认无需修改）
PROXY_PORT=8190
PROXY_HOST=0.0.0.0

# 烘焙模型下载配置（Realistic Vision V6.0 B1 VAE）
MODEL_NAME=Realistic_Vision_V6.0_B1_VAE.safetensors
MODEL_DOWNLOAD_URL=https://huggingface.co/everynightdawns/Realistic_Vision_V6.0_B1_VAE/resolve/main/Realistic_Vision_V6.0_B1_VAE.safetensors
MODEL_SHA256=fe7578cb5ee0be63aa15baa894ab5d1751ff9b5b25ef611d5fafb2186d930c30

# LCM-LoRA（SD1.5）下载配置（latent-consistency/lcm-lora-sdv1-5，官方 pytorch_lora_weights.safetensors）
LORA_NAME=lcm-lora-sdv1-5.safetensors
LORA_DOWNLOAD_URL=https://huggingface.co/latent-consistency/lcm-lora-sdv1-5/resolve/main/pytorch_lora_weights.safetensors
LORA_SHA256=8f90d840e075ff588a58e22c6586e2ae9a6f7922996ee6649a7f01072333afe4

# 是否跳过模型下载与校验（0: 正常下载校验; 1: 离线/测试跳过）
SKIP_MODEL_DOWNLOAD=0
