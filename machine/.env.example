# ==============================================================================
# Pix Server 环境变量模板
# 用户侧上机配置：复制为 .env 并填入实际值
# ==============================================================================

# 代理鉴权共享密钥（与 Worker 的 PIX_SERVER_SECRET 保持一致，切勿泄露）
PIX_SERVER_SECRET=your_pix_server_secret_here

# 容器内监听端口与地址（默认无需修改）
PROXY_PORT=8190
PROXY_HOST=0.0.0.0

# 烘焙模型下载配置（Realistic Vision V6.0 B1 VAE）
MODEL_NAME=Realistic_Vision_V6.0_B1_VAE.safetensors
MODEL_DOWNLOAD_URL=https://huggingface.co/everynightdawns/Realistic_Vision_V6.0_B1_VAE/resolve/main/Realistic_Vision_V6.0_B1_VAE.safetensors
MODEL_SHA256=fe7578cb5ee0be63aa15baa894ab5d1751ff9b5b25ef611d5fafb2186d930c30

# LCM-LoRA（SD1.5）下载配置（latent-consistency/lcm-lora-sdv1-5，官方 pytorch_lora_weights.safetensors）
LORA_NAME=lcm-lora-sdv1-5.safetensors
LORA_DOWNLOAD_URL=https://huggingface.co/latent-consistency/lcm-lora-sdv1-5/resolve/main/pytorch_lora_weights.safetensors
LORA_SHA256=8f90d840e075ff588a58e22c6586e2ae9a6f7922996ee6649a7f01072333afe4

# 首启时离线合并 LCM-LoRA 后的 checkpoint 文件名（写入 checkpoints 目录，宿主机持久化）
MERGED_MODEL_NAME=Realistic_Vision_V6.0_B1_LCM.safetensors

# 默认生图模型 ID（realistic-lcm | realistic | majicmix | dreamshaper | counterfeit）
DEFAULT_MODEL_ID=realistic-lcm

# majicMIX realistic v7 下载配置
MAJICMIX_MODEL_NAME=majicmixRealistic_v7.safetensors
MAJICMIX_DOWNLOAD_URL=https://huggingface.co/digiplay/majicMIX_realistic_v7/resolve/main/majicmixRealistic_v7.safetensors
MAJICMIX_SHA256=7c819b6d13663ed720c2254f4fe18373107dfef2448d337913c8fc545640881e

# DreamShaper 8 下载配置
DREAMSHAPER_MODEL_NAME=DreamShaper_8_pruned.safetensors
DREAMSHAPER_DOWNLOAD_URL=https://huggingface.co/Lykon/DreamShaper/resolve/main/DreamShaper_8_pruned.safetensors
DREAMSHAPER_SHA256=879db523c30d3b9017143d56705015e15a2cb5628762c11d086fed9538abd7fd

# Counterfeit-V3.0 fix_fp16 下载配置
COUNTERFEIT_MODEL_NAME=Counterfeit-V3.0_fix_fp16.safetensors
COUNTERFEIT_DOWNLOAD_URL=https://huggingface.co/gsdf/Counterfeit-V3.0/resolve/main/Counterfeit-V3.0_fix_fp16.safetensors
COUNTERFEIT_SHA256=a54c944e4c04e9d9ca43468ef5b90ea0408bb6264829a4980de79a768df7179f

# 是否跳过模型下载与校验（0: 正常下载校验; 1: 离线/测试跳过）
SKIP_MODEL_DOWNLOAD=0
